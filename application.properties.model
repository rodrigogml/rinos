# Este arquivo documenta e sugere valores para todas as propriedades do Rinos.
# Mantenha atributos, comentários e ordem sincronizados com o application.properties local.
# O application.properties contém os valores reais do ambiente e nunca deve ser versionado.

# Aplicação e infraestrutura Spring
spring.application.name=Rinos
spring.main.banner-mode=console
server.forward-headers-strategy=none

# Banco global de desenvolvimento; substitua os valores no arquivo local.
spring.datasource.url=jdbc:mysql://localhost:3306/rinos?useUnicode=true&characterEncoding=UTF-8
spring.datasource.username=rinos
spring.datasource.password=
spring.datasource.hikari.connection-init-sql=SET time_zone = '+00:00'
spring.jpa.hibernate.ddl-auto=none
spring.jpa.hibernate.naming.physical-strategy=org.hibernate.boot.model.naming.PhysicalNamingStrategyStandardImpl
spring.jpa.properties.hibernate.jdbc.time_zone=UTC
spring.jackson.time-zone=UTC

# Identificação e coordenação de manutenção
rinos.maintenance.instance-id=rinos-instance-01
rinos.maintenance.heartbeat-interval=30m
rinos.maintenance.lease-timeout=4h
rinos.maintenance.stabilization-period=10m
rinos.maintenance.batch-transaction-timeout=5m

# Cadastro e comprovação
rinos.registration.pending-retention=15d
rinos.registration.resend-limit=3
rinos.registration.resend-window=15m
rinos.verification.validity=24h

# Proteção por origem e proxies confiáveis
rinos.origin.turnstile-threshold=0
rinos.origin.absolute-limit=20
rinos.origin.window=24h
rinos.origin.retention-after-window=30d
rinos.proxy.trusted-proxies=

# Limpeza automática
rinos.cleanup.interval=24h
rinos.cleanup.batch-size=500

# Consulta de senhas comprometidas
rinos.hibp.endpoint=https://api.pwnedpasswords.com/range/
rinos.hibp.user-agent=Rinos/1.0.0
rinos.hibp.connect-timeout=5s
rinos.hibp.read-timeout=5s

# Argon2id; os valores não podem ficar abaixo do piso documentado.
rinos.password-hash.memory-kib=19456
rinos.password-hash.iterations=2
rinos.password-hash.parallelism=1
rinos.password-hash.salt-length=16
rinos.password-hash.hash-length=32

# Cloudflare Turnstile fornecido pelo RFW Platform
rfw.platform.authentication.turnstile.enabled=false
rfw.platform.authentication.turnstile.site-key=
rfw.platform.authentication.turnstile.secret-key=
rfw.platform.authentication.turnstile.expected-hostnames=
rfw.platform.authentication.turnstile.site-verify-endpoint=https://challenges.cloudflare.com/turnstile/v0/siteverify
rfw.platform.authentication.turnstile.timeout=10s

# Google Identity Services fornecido pelo RFW Platform
rfw.platform.authentication.google.enabled=false
rfw.platform.authentication.google.client-id=
rfw.platform.authentication.google.issuer=https://accounts.google.com

# SMTP e templates de e-mail consumidos pelo Spring Mail e RFW Platform
spring.mail.host=localhost
spring.mail.port=1025
spring.mail.username=
spring.mail.password=
spring.mail.protocol=smtp
spring.mail.default-encoding=UTF-8
spring.mail.properties.mail.smtp.auth=false
spring.mail.properties.mail.smtp.starttls.enable=false
spring.mail.properties.mail.smtp.connectiontimeout=5000
spring.mail.properties.mail.smtp.timeout=5000
spring.mail.properties.mail.smtp.writetimeout=5000
rfw.platform.mail.template-base-path=mail/templates
rfw.platform.mail.subject-suffix=.subject.txt
rfw.platform.mail.body-suffix=.body.html
rfw.platform.mail.body-html=true
rfw.platform.mail.default-from-address=no-reply@localhost
rfw.platform.mail.default-reply-to-address=

# Migrações do RFW; habilite somente quando o banco configurado estiver disponível.
rfw.platform.database.update.enabled=false

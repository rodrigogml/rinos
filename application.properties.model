# Este arquivo documenta e sugere valores para todas as propriedades do Rinos.
# Mantenha atributos, comentários e ordem sincronizados com o application.properties local.
# O application.properties contém os valores reais do ambiente e nunca deve ser versionado.

# Aplicação e infraestrutura Spring
spring.application.name=Rinos
spring.main.banner-mode=console
server.forward-headers-strategy=none
# Porta interna do JAR; o proxy reverso publica a origem canônica separadamente
server.port=7070
# Origem pública canônica usada em links absolutos enviados para fora da aplicação
rinos.application.public-base-url=http://localhost:7070

# Candidato exclusivo ao primeiro bootstrap administrativo global; não concede acesso após a conclusão.
rinos.access.bootstrap.administrator-email=admin@rinos.com.br

# Internacionalização, tema e componente público de acesso da RFW Platform
rfw.i18n.enabled=true
rfw.i18n.supported-language-locales=pt-BR,en,es,fr,it,zh-CN
rfw.i18n.default-language-locale=pt-BR
rfw.i18n.default-format-locale=pt-BR
rfw.i18n.default-zone-id=America/Sao_Paulo
rfw.i18n.application-basenames=messages
rfw.i18n.vaadin.enabled=true
rfw.i18n.vaadin.initialize-from-browser=true
rfw.ui.theme.project-key=rinos
rfw.ui.theme.default-theme=light
rfw.ui.theme.default-font-size=md
rfw.ui.theme.default-density=normal
rfw.ui.theme.default-visual-size=md
rfw.ui.theme.auto-apply=true
rfw.ui.theme.persist-cookies=true
rfw.ui.theme.apply-visual-size=true
rfw.ui.access.i18n-prefix=ui.access
rfw.ui.access.project-key=rinos
rfw.ui.access.theme-switcher-enabled=true
rfw.ui.access.language-switcher-enabled=true
rfw.ui.access.remember-me-enabled=false

# Banco global de desenvolvimento; substitua host e credenciais no arquivo local.
spring.datasource.url=jdbc:mysql://localhost:3306/rinos_global?useUnicode=true&characterEncoding=UTF-8
spring.datasource.username=rinos
spring.datasource.password=
spring.datasource.hikari.connection-init-sql=SET time_zone = '+00:00'
spring.jpa.hibernate.ddl-auto=none
spring.jpa.hibernate.naming.physical-strategy=org.hibernate.boot.model.naming.PhysicalNamingStrategyStandardImpl
spring.jpa.properties.hibernate.jdbc.time_zone=UTC
spring.jackson.time-zone=UTC

# MySQL 9 externo exclusivo para testes; desabilitado utiliza Testcontainers como fallback.
# A URL deve apontar apenas para o servidor, sem selecionar database.
rinos.test-database.external.enabled=false
rinos.test-database.external.server-url=jdbc:mysql://localhost:3306/?useUnicode=true&characterEncoding=UTF-8
rinos.test-database.external.username=rinos_test
rinos.test-database.external.password=

# Identificação e coordenação de manutenção
rinos.maintenance.instance-id=rinos-instance-01
rinos.maintenance.heartbeat-interval=30m
rinos.maintenance.lease-timeout=4h
rinos.maintenance.stabilization-period=10m
rinos.maintenance.batch-transaction-timeout=5m

# Fila estrutural de armazenamento dos tenants; configurações fixas da instalação.
rinos.storage.queue-poll-interval=30s
rinos.storage.operation-lease=10m
rinos.storage.operation-heartbeat-interval=30s
rinos.storage.provisioning-maximum-attempts=3
rinos.storage.maximum-concurrent-operations=1

# Cadastro e comprovação
rinos.registration.pending-retention=15d
rinos.registration.resend-limit=3
rinos.registration.resend-window=15m
# Limite independente de provas de cancelamento efetivamente emitidas para a mesma pendência.
rinos.registration.cancellation-request-limit=3
rinos.registration.cancellation-request-window=15m
rinos.verification.validity=24h

# Cadastro de contas: o limiar zero mantém Turnstile obrigatório para toda origem.
rinos.account-creation.turnstile-required-after=0
rinos.account-creation.origin-window=15m
rinos.account-creation.origin-limit=5
rinos.account-creation.origin-block-period=15m
# Chaves de repetição e a outbox são dados operacionais duráveis do cadastro.
rinos.account-creation.idempotency-retention=30d
rinos.account-creation.outbox-batch-size=25
rinos.account-creation.outbox-lease=2m
rinos.account-creation.outbox-retry-base=1m
rinos.account-creation.outbox-retry-maximum=1h
# Recuperação de senha local: provas, limites por usuário/origem e retenção técnica.
rinos.password-recovery.validity=1h
rinos.password-recovery.request-limit=3
rinos.password-recovery.request-window=15m
rinos.password-recovery.attempt-limit=20
rinos.password-recovery.attempt-window=15m
rinos.password-recovery.retention=30d

# Proteção por origem e proxies confiáveis
rinos.origin.turnstile-threshold=0
rinos.origin.absolute-limit=20
rinos.origin.window=24h
rinos.origin.retention-after-window=30d
rinos.proxy.trusted-proxies=

# Limpeza automática
rinos.cleanup.interval=24h
rinos.cleanup.batch-size=500

# Autenticação global: políticas fixas de sessão, abuso, notificação, MFA e retenção
rinos.authentication.session.normal-absolute=12h
rinos.authentication.session.normal-idle=30m
rinos.authentication.session.remembered-absolute=30d
rinos.authentication.session.remembered-idle=7d
rinos.authentication.session.activity-refresh-interval=5m
rinos.authentication.session.reauthentication-validity=15m
rinos.authentication.session.cookie-name=RINOS_AUTH
rinos.authentication.session.cookie-secure=true
rinos.authentication.session.cookie-same-site=Strict
rinos.authentication.abuse.failure-threshold=3
rinos.authentication.abuse.window=15m
rinos.authentication.abuse.turnstile-duration=15m
rinos.authentication.abuse.initial-delay=1s
rinos.authentication.abuse.maximum-delay=15m
rinos.authentication.abuse.retention=30d
rinos.authentication.notification.failed-login-cooldown=24h
rinos.authentication.notification.device-recognition=30d
rinos.authentication.retention.terminal-sessions=30d
rinos.authentication.retention.temporary-artifacts=30d
rinos.authentication.retention.identity-events=365d
rinos.authentication.mfa.challenge-validity=5m
rinos.authentication.mfa.maximum-attempts=5
rinos.authentication.mfa.email-resend-cooldown=1m
rinos.authentication.mfa.email-emission-limit=3
rinos.authentication.mfa.email-emission-window=15m

# Keyring local. Base64 canônico de 32+ bytes; a versão ativa escreve e as anteriores permanecem para leitura.
# Todas as instâncias usam o mesmo keyring. Não remova uma versão enquanto houver dado protegido por ela.
rinos.authentication.keyring.enabled=false
rinos.authentication.keyring.active-version=
rinos.authentication.keyring.keys.v1=

# WebAuthn. Cada perfil deve declarar origins compatíveis com seu RP ID.
# Para desenvolvimento local, use rp-id=localhost e allowed-origins=http://localhost:7070.
rfw.authentication.passkey.enabled=false
rfw.authentication.passkey.relying-party-id=app.rinos.com.br
rfw.authentication.passkey.relying-party-name=Rinos
rfw.authentication.passkey.allowed-origins=https://app.rinos.com.br
rfw.authentication.passkey.user-verification=required

# Consulta de senhas comprometidas
rinos.hibp.endpoint=https://api.pwnedpasswords.com/range/
rinos.hibp.user-agent=Rinos/1.0.0
rinos.hibp.connect-timeout=5s
rinos.hibp.read-timeout=5s

# Argon2id; os valores não podem ficar abaixo do piso documentado.
rinos.password-hash.memory-kib=19456
rinos.password-hash.iterations=2
rinos.password-hash.parallelism=1
rinos.password-hash.salt-length=16
rinos.password-hash.hash-length=32

# Cloudflare Turnstile fornecido pelo RFW Platform
# A action é derivada de cada operação pelo RFW e validada no retorno do Siteverify.
rfw.authentication.turnstile.enabled=false
rfw.authentication.turnstile.site-key=
rfw.authentication.turnstile.secret-key=
rfw.authentication.turnstile.expected-hostnames=
rfw.authentication.turnstile.site-verify-endpoint=https://challenges.cloudflare.com/turnstile/v0/siteverify
rfw.authentication.turnstile.timeout=10s
# Protocolo MFA da RFW: fonte única para TOTP, OTP por e-mail e recovery codes.
rfw.authentication.second-factor.totp-digits=6
rfw.authentication.second-factor.totp-period-seconds=30
rfw.authentication.second-factor.totp-window=1
rfw.authentication.second-factor.email-code-digits=6
# Contrato fixo do Rinos; qualquer valor diferente de 10 impede a inicialização.
rfw.authentication.second-factor.recovery-code-count=10

# Google Identity Services fornecido pelo RFW Platform
rfw.authentication.google.enabled=false
rfw.authentication.google.client-id=
rfw.authentication.google.issuer=https://accounts.google.com
rfw.authentication.google.timeout=10s
rfw.authentication.google.clock-skew=60s

# SMTP e templates de e-mail consumidos pelo Spring Mail e RFW Platform
spring.mail.host=localhost
spring.mail.port=1025
spring.mail.username=
spring.mail.password=
spring.mail.protocol=smtp
spring.mail.default-encoding=UTF-8
spring.mail.properties.mail.smtp.auth=false
spring.mail.properties.mail.smtp.starttls.enable=false
spring.mail.properties.mail.smtp.connectiontimeout=5000
spring.mail.properties.mail.smtp.timeout=5000
spring.mail.properties.mail.smtp.writetimeout=5000
rfw.mail.template-base-path=mail/templates
rfw.mail.subject-suffix=.subject.txt
rfw.mail.body-suffix=.body.html
rfw.mail.body-html=true
rfw.mail.default-from-address=no-reply@localhost
rfw.mail.default-reply-to-address=

# Migrações automáticas do banco global pelo RFW.
rfw.database.update.enabled=true
rfw.database.update.locations=classpath:db/global/update/
# Tempo máximo para adquirir o lock de migration; o lock permanece até a execução terminar.
rfw.database.update.lock-timeout=30s
